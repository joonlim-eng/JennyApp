{
  "expo": {
    "name": "JENNY",
    "slug": "order-app",
    "version": "1.0.86",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "order-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.orderapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "display": "standalone",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is needed to scan barcodes."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "android": {
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "620cfd6b-5d9c-4e17-8173-29104e61af9f"
      }
    }
  }
}
